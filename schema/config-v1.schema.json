{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adb-ready.dev/schemas/config-v1.json",
  "title": "ADB Ready configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "defaultProfile": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "adb": {
            "$ref": "#/$defs/adb"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "output": {
            "$ref": "#/$defs/output"
          },
          "targets": {
            "$ref": "#/$defs/targets"
          }
        }
      }
    },
    "adb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "boolean"
        },
        "unicode": {
          "type": "boolean"
        },
        "animation": {
          "type": "boolean"
        },
        "interactive": {
          "type": "boolean"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "adb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "boolean" },
        "unicode": { "type": "boolean" },
        "animation": { "type": "boolean" },
        "interactive": { "type": "boolean" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
