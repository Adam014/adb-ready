{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adb-ready.dev/schemas/config-v1.json",
  "title": "ADB Ready configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "defaultProfile": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "adb": {
            "$ref": "#/$defs/adb"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "output": {
            "$ref": "#/$defs/output"
          },
          "targets": {
            "$ref": "#/$defs/targets"
          },
          "dev": {
            "$ref": "#/$defs/dev"
          }
        }
      }
    },
    "adb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "boolean"
        },
        "unicode": {
          "type": "boolean"
        },
        "animation": {
          "type": "boolean"
        },
        "interactive": {
          "type": "boolean"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dev": {
      "$ref": "#/$defs/dev"
    }
  },
  "$defs": {
    "adb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "boolean" },
        "unicode": { "type": "boolean" },
        "animation": { "type": "boolean" },
        "interactive": { "type": "boolean" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": ["custom", "expo", "gradle", "react-native"]
        },
        "packageManager": {
          "enum": ["bun", "npm", "pnpm", "yarn"]
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "args"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string", "minLength": 1 }
          }
        },
        "reversePorts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "integer", "minimum": 1, "maximum": 65535 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["device"],
                "properties": {
                  "device": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "host": { "type": "integer", "minimum": 1, "maximum": 65535 }
                }
              }
            ]
          }
        },
        "logs": { "type": "boolean" },
        "cleanupPorts": { "type": "boolean" },
        "journal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEntries": { "type": "integer", "minimum": 1 },
            "maxBytes": { "type": "integer", "minimum": 1 },
            "sources": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "minimumSeverity": { "enum": ["debug", "info", "warning", "error"] },
            "redactEnvironment": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "uniqueItems": true
            }
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "beforeDev": { "$ref": "#/$defs/hooks" },
            "onTargetReady": { "$ref": "#/$defs/hooks" },
            "onPortsReady": { "$ref": "#/$defs/hooks" },
            "onReady": { "$ref": "#/$defs/hooks" },
            "onChildExit": { "$ref": "#/$defs/hooks" },
            "finally": { "$ref": "#/$defs/hooks" }
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hook" }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "failure": { "enum": ["fail", "warn", "ignore"] },
        "cwd": { "type": "string", "minLength": 1 },
        "envAllowlist": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "uniqueItems": true
        }
      }
    }
  }
}
