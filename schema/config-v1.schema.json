{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adb-ready.dev/schemas/config-v1.json",
  "title": "ADB Ready configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "defaultProfile": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "adb": {
            "$ref": "#/$defs/adb"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "output": {
            "$ref": "#/$defs/output"
          },
          "targets": {
            "$ref": "#/$defs/targets"
          },
          "app": {
            "$ref": "#/$defs/app"
          },
          "dev": {
            "$ref": "#/$defs/dev"
          }
        }
      }
    },
    "adb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "boolean"
        },
        "unicode": {
          "type": "boolean"
        },
        "animation": {
          "type": "boolean"
        },
        "interactive": {
          "type": "boolean"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "app": {
      "$ref": "#/$defs/app"
    },
    "dev": {
      "$ref": "#/$defs/dev"
    }
  },
  "$defs": {
    "adb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "boolean" },
        "unicode": { "type": "boolean" },
        "animation": { "type": "boolean" },
        "interactive": { "type": "boolean" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "android": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)+$"
            }
          }
        }
      }
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": ["capacitor", "custom", "expo", "flutter", "gradle", "react-native"]
        },
        "packageManager": {
          "enum": ["bun", "npm", "pnpm", "yarn"]
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "args"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string", "minLength": 1 }
          }
        },
        "reversePorts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "integer", "minimum": 1, "maximum": 65535 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["device"],
                "properties": {
                  "device": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "host": { "type": "integer", "minimum": 1, "maximum": 65535 }
                }
              }
            ]
          }
        },
        "logs": { "type": "boolean" },
        "cleanupPorts": { "type": "boolean" },
        "watch": { "type": "boolean" },
        "ready": { "$ref": "#/$defs/ready" },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1 },
            "initialDelayMs": { "type": "integer", "minimum": 1 },
            "maxDelayMs": { "type": "integer", "minimum": 1 },
            "totalTimeoutMs": { "type": "integer", "minimum": 1 }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persist": { "type": "boolean" },
            "maxSessions": { "type": "integer", "minimum": 1 },
            "maxAgeDays": { "type": "integer", "minimum": 1 },
            "maxBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "journal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEntries": { "type": "integer", "minimum": 1 },
            "maxBytes": { "type": "integer", "minimum": 1 },
            "sources": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "minimumSeverity": { "enum": ["debug", "info", "warning", "error"] },
            "redactEnvironment": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "uniqueItems": true
            }
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "beforeDev": { "$ref": "#/$defs/hooks" },
            "onTargetReady": { "$ref": "#/$defs/hooks" },
            "onPortsReady": { "$ref": "#/$defs/hooks" },
            "onReady": { "$ref": "#/$defs/hooks" },
            "onChildExit": { "$ref": "#/$defs/hooks" },
            "finally": { "$ref": "#/$defs/hooks" }
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hook" }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "pollIntervalMs": { "type": "integer", "minimum": 1 },
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/readinessAssertion" }
        }
      }
    },
    "readinessAssertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["boot", "unlocked"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package"],
          "properties": {
            "kind": { "enum": ["foreground", "process"] },
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "activity" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "port"],
          "properties": {
            "kind": { "const": "host-port" },
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "http" },
            "url": { "type": "string", "pattern": "^https?://" },
            "status": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 100, "maximum": 599 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "contains"],
          "properties": {
            "kind": { "const": "log" },
            "contains": { "type": "string", "minLength": 1, "maxLength": 256 },
            "absent": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector"],
          "properties": {
            "kind": { "const": "ui" },
            "selector": {
              "type": "string",
              "pattern": "^(?:desc|id|package|text)=.{1,256}$"
            },
            "state": { "enum": ["visible", "gone"] }
          }
        }
      ]
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "failure": { "enum": ["fail", "warn", "ignore"] },
        "cwd": { "type": "string", "minLength": 1 },
        "envAllowlist": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "uniqueItems": true
        }
      }
    }
  }
}
